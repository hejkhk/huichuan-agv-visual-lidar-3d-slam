    function t(source) {
        if (source === undefined || source === null) return ""
        var value = String(source)
        var catalog = language === "en" ? english : language === "ru" ? russian : chinese
        var extra = language === "en" ? englishNew
            : language === "ru" ? russianNew : null
        if (catalog && value.indexOf("已连接 ") === 0)
            return (language === "ru" ? "Подключено к " : "Connected to ") + value.slice(4)
        if (catalog && value.indexOf("多点路线（") === 0) {
            var count = value.replace(/[^0-9]/g, "")
            return language === "ru" ? "Маршрут по точкам (остановок: " + count + ")" : "Multi-point route (" + count + " stops)"
        }
        if (catalog && value.endsWith("接口尚未接入"))
            return language === "ru" ? "Интерфейс ещё не подключён" : "Interface is not connected yet"
        if (extra && extra[value] !== undefined)
            return extra[value]
        return catalog && catalog[value] !== undefined ? catalog[value] : value
    }
}
