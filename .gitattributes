* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Ubuntu/ROS source and configuration must keep Unix line endings.
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.lua text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows-only helpers keep native batch line endings.
*.bat text eol=crlf

# Maps and media are binary.
*.pgm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
