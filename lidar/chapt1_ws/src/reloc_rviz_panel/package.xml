<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reloc_rviz_panel</name>
  <version>1.0.0</version>
  <description>Localization-only RViz panel for verified Cartographer relocalization</description>
  <maintainer email="lzh@todo.todo">lzh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/reloc_panel_plugin.xml"/>
  </export>
</package>
