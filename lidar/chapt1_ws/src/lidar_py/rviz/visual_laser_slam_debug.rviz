Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.7
      Color Scheme: map
      Enabled: true
      Name: Cartographer Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Filtered LiDAR
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_timed_v2_filtered
      Size (m): 0.04
      Style: Points
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: Visual Odometry
      Topic:
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_odom
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: Wheel Odometry
      Topic:
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wheel/odom
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 500
      Name: EKF Fused Odometry
      Topic:
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Name: RGB
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.55
      Target Frame: odom
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 1500
