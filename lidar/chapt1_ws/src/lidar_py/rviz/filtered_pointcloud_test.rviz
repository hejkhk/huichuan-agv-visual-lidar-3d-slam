Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Base Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Raw Cloud (optional)
      Topic:
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/points
      Style: Points
      Size (Pixels): 1
      Size (m): 0.015
      Color Transformer: FlatColor
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Filtered Cloud
      Topic:
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/points_filtered
      Style: Points
      Size (Pixels): 3
      Size (m): 0.03
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0.5
      Name: Current View
      Pitch: 0.7
      Target Frame: base_link
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1500
