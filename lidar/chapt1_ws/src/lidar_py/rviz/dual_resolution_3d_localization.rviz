Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
  - Class: reloc_rviz_panel/RelocPanel
    Name: Verified Relocalization
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: false
      Name: Ground Grid
      Cell Size: 0.5
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.20
      Name: TF (single planar authority)
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: false
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: AGV URDF Collision Model
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.55
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.30
      Color Scheme: map
      Enabled: true
      Name: Live Mutable Navigation Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.18
      Color Scheme: map
      Enabled: false
      Name: Selected Reference Map (Immutable Audit)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization_reference_map
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Filtered 2D LiDAR
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_timed_v2_filtered
      Size (m): 0.03
      Style: Points
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Live Filtered 3D Points (15 Hz, Navigation Input)
      Topic:
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_highres_cloud_v21
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0.0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: 3-Frame Recent Geometry Marks (6s Local)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_highres_cloud_v21/sensor
      Style: Boxes
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 210; 40
      Decay Time: 0.0
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Strict Geometry Candidates (Debug Only)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_highres_cloud_v21/persistent_sensor
      Style: Boxes
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 95; 70
      Decay Time: 0.0
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Nav2 Bounded Obstacle Memory (3 cm / 6s)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/voxel_grid
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 190; 30
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.03
      Alpha: 0.85
      Decay Time: 0.0
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Local 3D Crop Volumes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_highres_cloud_v21/crop_markers
      Value: true
    - Class: rtabmap_rviz_plugins/MapCloud
      Enabled: false
      Name: RTAB-Map Persistent Low Resolution 3D
      Topic: /rtabmap_3d/mapData
      Cloud decimation: 4
      Cloud voxel size: 0.08
      Cloud max depth: 4.0
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: OctoMap 3D Occupied (RTAB-Map Optimized)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap_3d/octomap_occupied_space
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.05
      Alpha: 0.85
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: RTAB-Map Vertical Walls (Nav2 Input)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap_3d/navigation_walls
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 0; 255; 160
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.05
      Alpha: 0.80
      Value: false
    - Class: rviz_default_plugins/Map
      Alpha: 0.25
      Color Scheme: costmap
      Enabled: true
      Name: Nav2 Local Costmap (8x8 m near robot)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.25
      Color Scheme: costmap
      Enabled: false
      Name: Nav2 Global Planner Costmap (Path Audit)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Gemini2 RGB
      Normalize Range: true
      Topic:
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Stable Global Path (Smac 2D)
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Line Style: Lines
      Line Width: 0.04
      Color: 0; 190; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Nav2 Raw Grid Path
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Line Style: Lines
      Line Width: 0.025
      Color: 160; 160; 160
      Value: false
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 RPP Collision Lookahead Arc
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lookahead_arc
      Line Style: Lines
      Line Width: 0.05
      Color: 255; 180; 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 36; 39; 42
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 0.6
      Name: Current View
      Pitch: 0.65
      Target Frame: map
      Yaw: 0.75
Window Geometry:
  Navigation 2:
    collapsed: false
  Height: 920
  Width: 1500
