Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Map Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.65
      Color Scheme: map
      Enabled: true
      Name: Cartographer 2D Map
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: 2D LiDAR
      Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_timed_v2_filtered
      Size (m): 0.035
      Style: Points
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Gemini2 Filtered Live Cloud
      Topic:
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/points_filtered
      Style: Points
      Size (Pixels): 2
      Size (m): 0.025
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0.2
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: OctoMap 3D Occupied Voxels
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupied_cells_vis_array
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.35
      Color Scheme: costmap
      Enabled: false
      Name: OctoMap Projected 2D (debug only)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /projected_map
      Value: false
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 500
      Name: EKF Odom
      Topic:
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Name: RGB
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Name: Current View
      Pitch: 0.85
      Target Frame: map
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1500
