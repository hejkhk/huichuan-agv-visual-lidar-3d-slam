Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Odom Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 500
      Name: EKF Fused Odometry
      Topic:
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Filtered Live Cloud
      Topic:
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/points_filtered
      Style: Points
      Size (Pixels): 2
      Size (m): 0.025
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0.3
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: OctoMap Occupied Voxels
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupied_cells_vis_array
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: OctoMap Voxel Centers
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /octomap_point_cloud_centers
      Style: Boxes
      Size (m): 0.08
      Color Transformer: AxisColor
      Axis: Z
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0.7
      Name: Current View
      Pitch: 0.8
      Target Frame: odom
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1500
