Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Base Grid
      Plane: XY
      Cell Size: 0.25
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.20
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: STEP10V2 Direct Depth Cloud
      Topic:
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_highres_cloud_v2
      Style: Points
      Size (Pixels): 2
      Size (m): 0.018
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Crop / Self / Ground Volumes
      Topic:
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Value: /local_highres_cloud_v2/crop_markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Depth Image (enable only after latency test)
      Normalize Range: true
      Topic:
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/image_raw
      Value: false
  Enabled: true
  Global Options:
    Background Color: 36; 36; 36
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.5
      Focal Point:
        X: 1.4
        Y: 0
        Z: 0.5
      Name: Current View
      Pitch: 0.55
      Target Frame: base_link
      Yaw: 0.0
Window Geometry:
  Height: 900
  Width: 1500
