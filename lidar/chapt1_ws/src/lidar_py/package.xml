<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_py</name>
  <version>0.0.0</version>
  <description>Integrated ROS2 Humble LiDAR, Cartographer, Nav2, frontier exploration and web bridge nodes</description>
  <maintainer email="lzh@todo.todo">lzh</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <depend>visualization_msgs</depend>
  <depend>action_msgs</depend>
  <depend>python3-serial</depend>
  <exec_depend>python3-numpy</exec_depend>


  <!-- Native ROS 2 Humble Navigation2 dependencies -->
  <depend>nav2_map_server</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_smac_planner</depend>
  <depend>nav2_regulated_pure_pursuit_controller</depend>
  <depend>nav2_rotation_shim_controller</depend>
  <depend>dwb_core</depend>
  <exec_depend>spatio_temporal_voxel_layer</exec_depend>
  <depend>frontier_exploration_ros2</depend>
  <depend>nav2_waypoint_follower</depend>
  <exec_depend>short_goal_bt</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <depend>rviz2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <depend>laser_filters</depend>
  <depend>cartographer_ros</depend>
  <exec_depend>cartographer_ros_msgs</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>
  <exec_depend>rtabmap_rviz_plugins</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>local_depth_cloud_cpp</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
