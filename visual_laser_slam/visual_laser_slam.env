# RGB-D + 轮速 + IMU + 2D 激光融合测试参数
# 修改后直接运行根目录 STEP*.sh，无需改 Python/launch 文件。

ROS_DOMAIN_ID=88
USE_RVIZ=true

# Gemini2 低负载参数（树莓派5第一轮建议保持）
COLOR_WIDTH=640
COLOR_HEIGHT=480
COLOR_FPS=15
DEPTH_WIDTH=640
DEPTH_HEIGHT=400
DEPTH_FPS=10

# 相机相对 base_link 的静态外参，单位：米 / 弧度。
# ROS 车体坐标：x 向前、y 向左、z 向上。
# 重要：STEP4/STEP5 前请按实车测量修改，并把 CAMERA_TF_CONFIRMED 改成 true。
CAMERA_X=0.3
CAMERA_Y=0.0
CAMERA_Z=0.4
CAMERA_ROLL=0.0
CAMERA_PITCH=0.0
CAMERA_YAW=0.0
CAMERA_TF_CONFIRMED=true

# 串口留空时自动识别。也可写成 /dev/serial/by-id/...，比 ttyUSB 编号更稳定。
CHASSIS_PORT=
LIDAR_PORT=
LIDAR_BAUD=115200
LASER_YAW_DEG=0.0
SCAN_ANGLE_SIGN=-1.0

# 可选：若 Orbbec 驱动在独立工作空间，填写其 setup.bash。
# 例：ORBBEC_SETUP=/home/peter/OrbbecSDK_ROS2/install/setup.bash
ORBBEC_SETUP=

# true：每次自动重编 lidar_py；false：已有构建时直接使用。
AUTO_BUILD=true
# ====================== STEP6~STEP9 点云参数 ======================
# Orbbec 深度点云标准话题。若你的驱动话题不同，用 ros2 topic list 后修改。
POINT_CLOUD_TOPIC=/camera/depth/points
FILTERED_CLOUD_TOPIC=/camera/depth/points_filtered

# 树莓派5保守参数：最多处理5Hz，每隔4个点取1个，再做6cm体素降采样。
CLOUD_MAX_RATE_HZ=10.0
CLOUD_SAMPLE_STRIDE=2
CLOUD_VOXEL_SIZE=0.04
CLOUD_MIN_RANGE=0.25
CLOUD_MAX_RANGE=5.0
CLOUD_TRANSFORM_TIMEOUT=0.05

# 在 base_link 坐标系中保留的点云空间范围（单位：米）。
# x前、y左、z上。先保持宽松，观察后再收紧。
CLOUD_BASE_X_MIN=-0.50
CLOUD_BASE_X_MAX=4.50
CLOUD_BASE_Y_MIN=-3.00
CLOUD_BASE_Y_MAX=3.00
CLOUD_BASE_Z_MIN=-1.00
CLOUD_BASE_Z_MAX=2.50

# 是否删除车体自身盒子内的点。第一轮建议 false，确认盒子尺寸后再开。
CLOUD_REMOVE_SELF=false
CLOUD_SELF_X_MIN=-0.40
CLOUD_SELF_X_MAX=0.40
CLOUD_SELF_Y_MIN=-0.40
CLOUD_SELF_Y_MAX=0.40
CLOUD_SELF_Z_MIN=-0.20
CLOUD_SELF_Z_MAX=1.20
CLOUD_LOG_EVERY_N=30

# ====================== STEP8~STEP9 OctoMap参数 ======================
# 8cm体素适合树莓派5第一轮测试。越小越清晰，但CPU/内存增长很快。
OCTOMAP_RESOLUTION=0.08
OCTOMAP_MAX_RANGE=4.0

# OctoMap在世界坐标系中接收/显示的高度范围。
OCTOMAP_POINT_MIN_Z=-2.0
OCTOMAP_POINT_MAX_Z=3.0
OCTOMAP_OCCUPANCY_MIN_Z=-1.0
OCTOMAP_OCCUPANCY_MAX_Z=2.5

# 自动RANSAC地面过滤较耗算力且依赖base_link高度，第一轮关闭。
OCTOMAP_FILTER_GROUND=false
# false可减少无人订阅时的发布负载；RViz订阅后仍会正常显示。
OCTOMAP_LATCH=false
