# RGB-D + 轮速 + IMU + 2D 激光融合测试参数
# 修改后直接运行根目录 STEP*.sh，无需改 Python/launch 文件。

ROS_DOMAIN_ID=88
USE_RVIZ=true

# Gemini2 低负载参数（树莓派5第一轮建议保持）
COLOR_WIDTH=640
COLOR_HEIGHT=480
COLOR_FPS=15
DEPTH_WIDTH=640
DEPTH_HEIGHT=400
DEPTH_FPS=10

# 相机相对 base_link 的静态外参，单位：米 / 弧度。
# ROS 车体坐标：x 向前、y 向左、z 向上。
# 重要：STEP4/STEP5 前请按实车测量修改，并把 CAMERA_TF_CONFIRMED 改成 true。
CAMERA_X=0.3
CAMERA_Y=0.0
CAMERA_Z=0.4
CAMERA_ROLL=0.0
CAMERA_PITCH=0.0
CAMERA_YAW=0.0
CAMERA_TF_CONFIRMED=true

# 串口留空时自动识别。也可写成 /dev/serial/by-id/...，比 ttyUSB 编号更稳定。
CHASSIS_PORT=
LIDAR_PORT=
LIDAR_BAUD=115200
LASER_YAW_DEG=0.0
SCAN_ANGLE_SIGN=-1.0

# 可选：若 Orbbec 驱动在独立工作空间，填写其 setup.bash。
# 例：ORBBEC_SETUP=/home/peter/OrbbecSDK_ROS2/install/setup.bash
ORBBEC_SETUP=

# true：每次自动重编 lidar_py；false：已有构建时直接使用。
AUTO_BUILD=true
# ====================== STEP6~STEP9 点云参数 ======================
# Orbbec 深度点云标准话题。若你的驱动话题不同，用 ros2 topic list 后修改。
POINT_CLOUD_TOPIC=/camera/depth/points
FILTERED_CLOUD_TOPIC=/camera/depth/points_filtered

# 树莓派5保守参数：最多处理5Hz，每隔4个点取1个，再做6cm体素降采样。
CLOUD_MAX_RATE_HZ=10.0
CLOUD_SAMPLE_STRIDE=2
CLOUD_VOXEL_SIZE=0.04
CLOUD_MIN_RANGE=0.25
CLOUD_MAX_RANGE=5.0
CLOUD_TRANSFORM_TIMEOUT=0.05

# 在 base_link 坐标系中保留的点云空间范围（单位：米）。
# x前、y左、z上。先保持宽松，观察后再收紧。
CLOUD_BASE_X_MIN=-0.50
CLOUD_BASE_X_MAX=4.50
CLOUD_BASE_Y_MIN=-3.00
CLOUD_BASE_Y_MAX=3.00
CLOUD_BASE_Z_MIN=-1.00
CLOUD_BASE_Z_MAX=2.50

# 是否删除车体自身盒子内的点。第一轮建议 false，确认盒子尺寸后再开。
CLOUD_REMOVE_SELF=false
CLOUD_SELF_X_MIN=-0.40
CLOUD_SELF_X_MAX=0.40
CLOUD_SELF_Y_MIN=-0.40
CLOUD_SELF_Y_MAX=0.40
CLOUD_SELF_Z_MIN=-0.20
CLOUD_SELF_Z_MAX=1.20
CLOUD_LOG_EVERY_N=30

# ====================== STEP8~STEP9 OctoMap参数 ======================
# 8cm体素适合树莓派5第一轮测试。越小越清晰，但CPU/内存增长很快。
OCTOMAP_RESOLUTION=0.08
OCTOMAP_MAX_RANGE=4.0

# OctoMap在世界坐标系中接收/显示的高度范围。
OCTOMAP_POINT_MIN_Z=-2.0
OCTOMAP_POINT_MAX_Z=3.0
OCTOMAP_OCCUPANCY_MIN_Z=-1.0
OCTOMAP_OCCUPANCY_MAX_Z=2.5

# 自动RANSAC地面过滤较耗算力且依赖base_link高度，第一轮关闭。
OCTOMAP_FILTER_GROUND=false
# false可减少无人订阅时的发布负载；RViz订阅后仍会正常显示。
OCTOMAP_LATCH=false

# ====================== STEP10 实时局部高精度点云 ======================
# 这一条链只用于近距离实时避障，不写入全局OctoMap，不修改STEP1~STEP9。
LOCAL_HIGHRES_CLOUD_TOPIC=/local_highres_cloud
LOCAL_HIGHRES_STATS_TOPIC=/local_highres_cloud/stats
LOCAL_HIGHRES_MARKER_TOPIC=/local_highres_cloud/crop_markers

# 3060电脑第一版：保持原始点密度，2.5cm体素，目标8~10Hz以上。
LOCAL_MAX_RATE_HZ=12.0
LOCAL_SAMPLE_STRIDE=1
LOCAL_VOXEL_SIZE=0.025
LOCAL_MIN_RANGE=0.20
LOCAL_MAX_RANGE=4.0
LOCAL_TRANSFORM_TIMEOUT=0.03

# 在base_link坐标系中的实时感知窗口：x前、y左、z上。
LOCAL_X_MIN=0.20
LOCAL_X_MAX=4.00
LOCAL_Y_MIN=-2.50
LOCAL_Y_MAX=2.50
LOCAL_Z_MIN=-0.50
LOCAL_Z_MAX=2.00

# 简化车体自身盒子。当前车体约66.5cm见方，后续STEP12会换成URDF模型自过滤。
LOCAL_REMOVE_SELF=true
LOCAL_SELF_X_MIN=-0.36
LOCAL_SELF_X_MAX=0.36
LOCAL_SELF_Y_MIN=-0.36
LOCAL_SELF_Y_MAX=0.36
LOCAL_SELF_Z_MIN=-0.10
LOCAL_SELF_Z_MAX=0.90

# 第一轮关闭地面过滤，先观察地面实际Z值；确认后再开启并调整上下边界。
LOCAL_GROUND_FILTER_ENABLED=false
LOCAL_GROUND_Z_MIN=-0.06
LOCAL_GROUND_Z_MAX=0.08

LOCAL_STATS_PERIOD_SEC=1.0
LOCAL_PUBLISH_MARKERS=true

# ====================== STEP10V2 直接深度图→局部点云 ======================
# 与原STEP10并存。V2关闭Orbbec完整PointCloud2，改由C++直接读取Depth Image。
# Gemini2原生深度最高可到1280x800；默认用原生1280x800@30，保留完整宽视场。
STEP10V2_ENABLE_COLOR=false
STEP10V2_COLOR_WIDTH=1280
STEP10V2_COLOR_HEIGHT=720
STEP10V2_COLOR_FPS=30
STEP10V2_DEPTH_WIDTH=1280
STEP10V2_DEPTH_HEIGHT=800
STEP10V2_DEPTH_FPS=30
STEP10V2_DEPTH_REGISTRATION=false
STEP10V2_ENABLE_FRAME_SYNC=false
STEP10V2_ENABLE_NOISE_REMOVAL_FILTER=false

STEP10V2_DEPTH_TOPIC=/camera/depth/image_raw
STEP10V2_CAMERA_INFO_TOPIC=/camera/depth/camera_info
STEP10V2_CLOUD_TOPIC=/local_highres_cloud_v2
STEP10V2_STATS_TOPIC=/local_highres_cloud_v2/stats
STEP10V2_MARKER_TOPIC=/local_highres_cloud_v2/crop_markers

# 1280x800下stride=2会读取约25%的像素；C++实时投影后再做3cm体素去重。
STEP10V2_MAX_RATE_HZ=30.0
STEP10V2_PIXEL_STRIDE=2
STEP10V2_DEPTH_UNIT_SCALE=0.001
STEP10V2_VOXEL_SIZE=0.03
STEP10V2_MIN_RANGE=0.20
STEP10V2_MAX_RANGE=4.0
STEP10V2_TRANSFORM_TIMEOUT=0.015

# 像素ROI，-1代表自动到图像边界。默认保留完整宽视场，确保左右三路都不被裁掉。
STEP10V2_ROI_U_MIN=0
STEP10V2_ROI_U_MAX=-1
STEP10V2_ROI_V_MIN=0
STEP10V2_ROI_V_MAX=-1

# base_link局部空间窗口：x前、y左、z上。
STEP10V2_X_MIN=0.15
STEP10V2_X_MAX=4.00
STEP10V2_Y_MIN=-2.50
STEP10V2_Y_MAX=2.50
STEP10V2_Z_MIN=-0.50
STEP10V2_Z_MAX=2.00

STEP10V2_REMOVE_SELF=true
STEP10V2_SELF_X_MIN=-0.36
STEP10V2_SELF_X_MAX=0.36
STEP10V2_SELF_Y_MIN=-0.36
STEP10V2_SELF_Y_MAX=0.36
STEP10V2_SELF_Z_MIN=-0.10
STEP10V2_SELF_Z_MAX=0.90

STEP10V2_GROUND_FILTER_ENABLED=false
STEP10V2_GROUND_Z_MIN=-0.06
STEP10V2_GROUND_Z_MAX=0.08
STEP10V2_STATS_PERIOD_SEC=1.0
STEP10V2_PUBLISH_MARKERS=true

# ====================== STEP10V2.1 稳定低延迟局部点云 ======================
# 相比V2：订阅回调只保存最新帧，独立线程处理；静态TF只查一次；射线表/体素表/点缓存预分配。
STEP10V21_ENABLE_COLOR=false
STEP10V21_COLOR_WIDTH=1280
STEP10V21_COLOR_HEIGHT=720
STEP10V21_COLOR_FPS=30
STEP10V21_DEPTH_WIDTH=640
STEP10V21_DEPTH_HEIGHT=400
STEP10V21_DEPTH_FPS=30
STEP10V21_DEPTH_REGISTRATION=false
STEP10V21_ENABLE_FRAME_SYNC=false
STEP10V21_ENABLE_NOISE_REMOVAL_FILTER=false

# 关闭“深度自动曝光优先”，避免暗光时为曝光牺牲帧率。
STEP10V21_ENABLE_DEPTH_AUTO_EXPOSURE_PRIORITY=false
# 设备时间映射到主机ROS时间，便于和TF/里程计对齐。
STEP10V21_ENABLE_SYNC_HOST_TIME=true
STEP10V21_TIME_DOMAIN=device
STEP10V21_TIME_SYNC_PERIOD=60.0
# 正常运行默认不写CSV，避免磁盘I/O干扰；排查相机卡顿时临时改true。
STEP10V21_ENABLE_FRAME_TIMESTAMP_CSV=false
STEP10V21_FRAME_TIMESTAMP_CSV_FILE=/tmp/orbbec_step10v21_timestamp.csv

STEP10V21_DEPTH_TOPIC=/camera/depth/image_raw
STEP10V21_CAMERA_INFO_TOPIC=/camera/depth/camera_info
STEP10V21_CLOUD_TOPIC=/local_highres_cloud_v21
STEP10V21_STATS_TOPIC=/local_highres_cloud_v21/stats
STEP10V21_MARKER_TOPIC=/local_highres_cloud_v21/crop_markers

STEP10V21_MAX_RATE_HZ=30.0
STEP10V21_PIXEL_STRIDE=2
STEP10V21_DEPTH_UNIT_SCALE=0.001
STEP10V21_VOXEL_SIZE=0.03
STEP10V21_MIN_RANGE=0.20
STEP10V21_MAX_RANGE=4.0
# 只在启动阶段缓存静态TF时允许等待；运行中不再逐帧等TF。
STEP10V21_TRANSFORM_TIMEOUT=0.50
# 邮箱里若只剩过旧帧，直接丢弃，不让避障处理“历史画面”。
STEP10V21_MAX_INPUT_AGE_MS=150.0

STEP10V21_ROI_U_MIN=0
STEP10V21_ROI_U_MAX=-1
STEP10V21_ROI_V_MIN=0
STEP10V21_ROI_V_MAX=-1
STEP10V21_X_MIN=0.15
STEP10V21_X_MAX=4.00
STEP10V21_Y_MIN=-2.50
STEP10V21_Y_MAX=2.50
STEP10V21_Z_MIN=-0.50
STEP10V21_Z_MAX=2.00

STEP10V21_REMOVE_SELF=true
STEP10V21_SELF_X_MIN=-0.36
STEP10V21_SELF_X_MAX=0.36
STEP10V21_SELF_Y_MIN=-0.36
STEP10V21_SELF_Y_MAX=0.36
STEP10V21_SELF_Z_MIN=-0.10
STEP10V21_SELF_Z_MAX=0.90
STEP10V21_GROUND_FILTER_ENABLED=false
STEP10V21_GROUND_Z_MIN=-0.06
STEP10V21_GROUND_Z_MAX=0.08

STEP10V21_STATS_PERIOD_SEC=1.0
STEP10V21_STATS_WINDOW_SIZE=300
STEP10V21_PROCESS_WARN_MS=50.0
STEP10V21_AGE_WARN_MS=120.0
STEP10V21_STALL_WARN_GAP_MS=120.0
STEP10V21_PUBLISH_MARKERS=true

# ====================== RGB-D 时间戳同步独立诊断 ======================
# 不修改已经跑通的STEP1-9；先用该模式验证15Hz/15Hz、硬件对齐、帧同步和主机时间同步。
RGBD_SYNC_COLOR_WIDTH=1280
RGBD_SYNC_COLOR_HEIGHT=720
RGBD_SYNC_COLOR_FPS=15
RGBD_SYNC_DEPTH_WIDTH=1280
RGBD_SYNC_DEPTH_HEIGHT=800
RGBD_SYNC_DEPTH_FPS=15
RGBD_SYNC_STATS_TOPIC=/rgbd_timestamp_sync/stats
RGBD_SYNC_MAX_PAIR_INTERVAL_MS=40.0
RGBD_SYNC_WARN_P95_MS=25.0
RGBD_SYNC_WINDOW_SIZE=300
RGBD_SYNC_ENABLE_FRAME_TIMESTAMP_CSV=true
RGBD_SYNC_FRAME_TIMESTAMP_CSV_FILE=/tmp/orbbec_rgbd_sync_timestamp.csv
