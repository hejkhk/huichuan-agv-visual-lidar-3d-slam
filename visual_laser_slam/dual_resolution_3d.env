# STEP11 dual-resolution 2D + 3D mapping settings.
ROS_DOMAIN_ID=88
USE_RVIZ=true
USE_RTABMAP_VIZ=false
ENABLE_RTABMAP=true
# Keep RGB-D keyframes and visual loop detection running even when the RViz
# MapCloud display is hidden. Unchecking it still removes RViz rendering load.
RTABMAP_ON_DEMAND_PAUSE=false
# Mapping-only is the default. The navigation wrapper overrides this to true.
ENABLE_NAVIGATION=false
ENABLE_VISUAL_FUSION=false
# STVL is the bounded dynamic local/global obstacle memory. Structural history
# remains in Cartographer's static map and RTAB-Map's filtered vertical walls.
ENABLE_STVL=true
AUTO_BUILD=true

# Localization-only mutable 2D navigation map. New LiDAR endpoints are added
# after 3 evidence frames; old occupied cells clear after 20 free-ray frames.
# Evidence is intentionally capped at 5 Hz (about 0.6 s mark / 4 s clear).
MUTABLE_MAP_MARK_CONFIRMATIONS=3
MUTABLE_MAP_CLEAR_CONFIRMATIONS=20
MUTABLE_MAP_EVIDENCE_RATE=5.0

# Lightweight /proc accounting is sampled every 2 s and reported every 20 s.
# Keep this enabled during real tests so performance regressions are measurable.
ENABLE_RESOURCE_MONITOR=true
RESOURCE_MONITOR_REPORT_INTERVAL=20.0

# Leave empty for USB VID/PID auto-detection.
CHASSIS_PORT=
LIDAR_PORT=
LIDAR_BAUD=115200
LASER_YAW_DEG=0.0
SCAN_ANGLE_SIGN=-1.0
LIDAR_X=0.20
LIDAR_Y=0.0
# base_link is on the ground: 0.321 m body height + 0.1025 m above the top.
LIDAR_Z=0.4235

# Validated chassis/Cartographer direction settings.
NAVI_YAW_SIGN=1.0
NAVI_VX_SIGN=1.0
NAVI_VZ_SIGN=1.0
NAVI_YAW_OFFSET_DEG=0.0
NAVI_ODOM_YAW_SOURCE=absolute
# Physical continuity guard. Normal AGV turns are far below 120 deg/s; only
# impossible 20 ms yaw steps are limited.
NAVI_MAX_YAW_RATE_DEG_S=120.0
# Track slow STM32-vs-host oscillator drift without timestamp jumps. At 50 Hz,
# 250 samples form an approximately 5-second minimum-delay window.
NAVI_ADAPTIVE_CLOCK_SYNC=true
NAVI_CLOCK_WINDOW_SAMPLES=250
NAVI_CLOCK_MAX_ADJUSTMENT_NS=20000
# If scan matching sees real motion while 0x07 still reports zero motion,
# seize MOVE with zero speed before the inconsistent odometry can rotate a map.
NAVI_MOTION_WATCHDOG_ENABLED=true
NAVI_MOTION_WATCHDOG_WARMUP_SEC=6.0
NAVI_MOTION_WATCHDOG_WINDOW_SEC=0.75
NAVI_MOTION_WATCHDOG_TRANSLATION_M=0.08
NAVI_MOTION_WATCHDOG_YAW_DEG=3.0

# Measured Gemini2 position in base_link (metres).
CAMERA_X=0.30
CAMERA_Y=0.0
CAMERA_Z=0.3648

# Camera mounting angles in DEGREES. These values are intentionally exposed for
# calibration. ROS convention: +roll tilts left side up, +pitch points the
# camera optical direction downward, +yaw turns it left.
CAMERA_ROLL_DEG=-0.618
# Provisional value calculated from the supplied stationary acceleration.
CAMERA_PITCH_DEG=25.979
# Top view: ROS positive yaw is counter-clockwise, so clockwise 45 deg is -45.
# STEP9's verified forward-facing convention is zero. Do not guess yaw from
# accelerometer data; only change this after a target-based extrinsic calibration.
CAMERA_YAW_DEG=-7.632
CAMERA_GROUND_CALIBRATED=true
CAMERA_EXTRINSIC_CALIBRATED=true

# RGB-D is synchronized at 15 Hz. The local cloud keeps the STEP10V2.1
# three-lane field of view and normally outputs at the same 15 Hz.
COLOR_WIDTH=640
COLOR_HEIGHT=480
COLOR_FPS=15
DEPTH_WIDTH=640
DEPTH_HEIGHT=400
DEPTH_FPS=15
# Preserve the native depth field of view. Software C2D aligns RGB to depth;
# hardware D2C would crop depth to the narrower RGB field of view.
# Keep both native streams untouched. depth_image_proc creates a separate
# depth-to-colour registration exclusively for RTAB-Map, so raw RGB stays real.
CAMERA_DEPTH_REGISTRATION=false
CAMERA_ALIGN_MODE=HW
CAMERA_ALIGN_TARGET_STREAM=COLOR
# Gemini2 global timestamps avoid the periodic timestamp jumps produced by
# device-domain timerSyncWithHost() while streams are already running.
CAMERA_TIME_DOMAIN=global
CAMERA_TIME_SYNC_PERIOD=10.0
RGBD_SYNC_MAX_INTERVAL=0.045
RGBD_SYNC_MAX_INTERVAL_MS=45.0
RGBD_SYNC_WARN_P95_MS=35.0

# Persistent low-resolution RTAB-Map V4 graph. V4 starts with the native RGB +
# depth_image_proc registration pipeline and never loads old black C2D nodes.
RTABMAP_DATABASE=maps/rtabmap_3d/rtabmap_v4_color.db
# Empty means platform-aware default: Jetson=1 Hz, x86 workstation=2 Hz.
# Use DUAL_3D_RTABMAP_RATE for an explicit per-session override.
RTABMAP_RATE=
GLOBAL_3D_VOXEL=0.05
GLOBAL_3D_RANGE_MAX=4.0
RESET_GLOBAL_3D_MAP=false
# Archive the old database when camera pose/alignment/stream geometry changes.
AUTO_RESET_3D_MAP_ON_CONFIG_CHANGE=true

# RTX 3060 host: RTAB-Map's optimized persistent geometry map. It follows
# RTABMAP_RATE and GLOBAL_3D_VOXEL; the old OCTOMAP_RATE variable never owned
# a running octomap_server and is intentionally removed.
USE_OCTOMAP=true
# RTAB-Map persists its 3D graph in RTABMAP_DATABASE continuously. The old
# octomap_saver call targeted a topic that this stack does not publish and
# therefore always timed out during Ctrl+C.
SAVE_OCTOMAP_ON_EXIT=false
OCTOMAP_SAVE_PATH=maps_3d/octomap_latest.bt

# Fast local 3D cloud for collision/avoidance. These are the stable V2.1 ROI
# values that preserve the full left/centre/right driving corridors.
LOCAL_CLOUD_TOPIC=/local_highres_cloud_v21
LOCAL_SENSOR_CLOUD_TOPIC=/local_highres_cloud_v21/sensor
LOCAL_STATS_TOPIC=/local_highres_cloud_v21/stats
LOCAL_MARKER_TOPIC=/local_highres_cloud_v21/crop_markers
LOCAL_RATE=15.0
LOCAL_STRIDE=2
LOCAL_VOXEL=0.03
LOCAL_MIN_RANGE=0.20
LOCAL_MAX_RANGE=4.0
LOCAL_X_MIN=0.15
LOCAL_X_MAX=4.0
LOCAL_Y_MIN=-2.5
LOCAL_Y_MAX=2.5
LOCAL_Z_MIN=-0.5
LOCAL_Z_MAX=2.0

# Remove the calibrated floor only from the low-latency collision cloud.
# The runner enables this after CAMERA_GROUND_CALIBRATED=true; persistent
# RTAB-Map/OctoMap mapping keeps its independent geometry input.
LOCAL_GROUND_FILTER=true
LOCAL_GROUND_Z_MIN=-0.10
# Preserve real low obstacles: only the first 2 cm above the calibrated floor
# is treated as floor residual. Isolated sub-voxel speckles are removed by the
# existing spatial and voxel-neighbour filters.
LOCAL_GROUND_Z_MAX=0.02

# Conservative three-stage obstacle-cloud filtering. Large depth changes are
# accepted immediately, so people/boxes appear and clear without ghost delay.
LOCAL_SPATIAL_FILTER=true
LOCAL_SPATIAL_THRESHOLD_M=0.08
LOCAL_SPATIAL_THRESHOLD_RATIO=0.025
LOCAL_SPATIAL_MIN_NEIGHBORS=2
LOCAL_TEMPORAL_FILTER=true
LOCAL_TEMPORAL_ALPHA=0.65
LOCAL_TEMPORAL_MAX_DELTA_M=0.06
LOCAL_VOXEL_OUTLIER_FILTER=true
LOCAL_VOXEL_MIN_NEIGHBORS=1

# Optional Orbbec workspace overlay, for example:
# ORBBEC_SETUP=/home/user/OrbbecSDK_ROS2/install/setup.bash
ORBBEC_SETUP=
