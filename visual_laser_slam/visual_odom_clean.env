# Clean standalone RGB-D odometry test. This does not change STEP1-STEP9.
VISUAL_ODOM_CLEAN_USE_RVIZ=false
VO_COLOR_WIDTH=640
VO_COLOR_HEIGHT=480
VO_COLOR_FPS=15
VO_DEPTH_WIDTH=640
VO_DEPTH_HEIGHT=400
VO_DEPTH_FPS=15
VO_APPROX_SYNC_MAX_INTERVAL=0.020
VO_TOPIC_QUEUE_SIZE=1
VO_SYNC_QUEUE_SIZE=3
VO_WAIT_FOR_TRANSFORM=0.10

# 关闭RTAB-Map常速度运动猜测，避免急转/手持晃动时先按错误guess失败再重算。
VO_ODOM_GUESS_MOTION=false

# 图像降采样倍率。:- 允许 STEP 脚本 export 覆盖此处默认值。
VO_ODOM_IMAGE_DECIMATION=${VO_ODOM_IMAGE_DECIMATION:-1}
